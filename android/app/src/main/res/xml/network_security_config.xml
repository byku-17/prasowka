<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Domyślnie: tylko HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Legacy źródła RSS, które nadal serwują wyłącznie po HTTP — wyjątek tylko dla nich -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">gazetaprawna.pl</domain>
        <domain includeSubdomains="true">interia.pl</domain>
        <domain includeSubdomains="true">forsal.pl</domain>
        <domain includeSubdomains="true">benchmark.pl</domain>
        <domain includeSubdomains="true">tvp.pl</domain>
        <domain includeSubdomains="true">sciam.com</domain>
    </domain-config>
</network-security-config>