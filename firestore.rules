rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Domyślnie: brak dostępu dla niezalogowanych i obcych danych.
    match /{document=**} {
      allow read, write: if false;
    }

    // Tylko właściciel konta może czytać/zapisywać swoje dane.
    // Aplikacja zapisuje wszystko pod: users/{uid}/{kolekcja}/{dokument}
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}